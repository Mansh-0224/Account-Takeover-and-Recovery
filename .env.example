# Example environment variables for local development.
# Spring Boot does NOT read a .env file by itself. Either:
#   - export these variables in your terminal before running the backend, or
#   - set them as environment variables in your IDE run configuration.
# Copy this file to ".env" (which is git-ignored) if you want to keep your own values.
# If you don't set anything, the defaults in application.properties are used.

DB_URL=jdbc:postgresql://localhost:5432/ato_db
DB_USERNAME=ato_user
DB_PASSWORD=ato_password
