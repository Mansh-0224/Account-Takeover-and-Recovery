{
  "info": {
    "name": "ATO Containment Service",
    "description": "Collection for the ATO Containment Service API. Phase 3 uses bearer-token sessions: run 'Login' or 'Register' first (the test script saves the returned sessionToken as a collection variable), then every other request automatically sends it via the Authorization header. Seeded users are documented in backend DataSeeder.java.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "sessionToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Service reports UP', function () { pm.expect(pm.response.json().status).to.eql('UP'); });",
                  "pm.test('Database reports UP', function () { pm.expect(pm.response.json().database).to.eql('UP'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        },
        {
          "name": "Unknown endpoint returns JSON 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });",
                  "pm.test('Body uses the standard error format', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql(404);",
                  "    pm.expect(body).to.have.property('message');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/does-not-exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "does-not-exist"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth (Phase 2 & 3)",
      "item": [
        {
          "name": "Register (new tenant + admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns a session token', function () { pm.expect(pm.response.json().sessionToken).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Postman Test Co\",\n  \"email\": \"postman.test@example.com\",\n  \"password\": \"demo1234\",\n  \"fullName\": \"Postman Tester\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login (Tenant A admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns a session token', function () { pm.expect(pm.response.json().sessionToken).to.be.a('string'); });",
                  "pm.test('Returns the logged-in user', function () { pm.expect(pm.response.json().user.email).to.eql('priya.nair@northwind.io'); });",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('sessionToken', pm.response.json().sessionToken); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"priya.nair@northwind.io\",\n  \"password\": \"demo1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Who am I (requires login first)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 if logged in via Postman cookie jar', function () { pm.expect([200,401]).to.include(pm.response.code); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Users (Phase 2 - tenant isolation)",
      "item": [
        {
          "name": "List users in my tenant (requires login first)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          }
        },
        {
          "name": "Get one user by id (404 if it belongs to another tenant)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/REPLACE_WITH_A_USER_ID",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "REPLACE_WITH_A_USER_ID"
              ]
            }
          }
        },
        {
          "name": "Get one user WITH a spoofed tenantId query param (still ignored)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('A spoofed tenantId query param has no effect', function () { pm.expect([200,404,401]).to.include(pm.response.code); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/REPLACE_WITH_A_USER_ID?tenantId=someone-elses-tenant",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "REPLACE_WITH_A_USER_ID"
              ],
              "query": [
                {
                  "key": "tenantId",
                  "value": "someone-elses-tenant"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Sessions (Phase 3)",
      "item": [
        {
          "name": "List my sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            }
          }
        },
        {
          "name": "Revoke one session (404 if not yours)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/REPLACE_WITH_A_SESSION_ID",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "REPLACE_WITH_A_SESSION_ID"
              ]
            }
          }
        },
        {
          "name": "Log out everywhere (revoke all my sessions)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            }
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"demo1234\",\n  \"newPassword\": \"a-new-password-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "password"
              ]
            }
          }
        }
      ]
    }
  ]
}